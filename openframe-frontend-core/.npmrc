//registry.npmjs.org/:_authToken=${NPM_TOKEN}
# Required for this workspace: @hookform/resolvers floats to a version whose
# OPTIONAL valibot@^1 peer conflicts with the valibot@0.39 that @typeschema
# pins (the lib uses zod, not valibot — the peer is unused). Committing the
# flag here makes every install (local, CI, snapshot) succeed WITHOUT anyone
# remembering `--legacy-peer-deps`. This is the permanent fix for the recurring
# ERESOLVE on `npm install`.
legacy-peer-deps=true
