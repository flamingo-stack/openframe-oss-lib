  "scripts": {
    "type-check": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/type-check.tsbuildinfo",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' tsup --watch",
    "build": "rm -rf dist && NODE_OPTIONS='--max-old-space-size=8192' tsup && tsc -p tsconfig.declarations.json",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=8192' tsup --no-dts",
    "clean": "rm -rf dist node_modules/.cache",
    "prepack": "NODE_OPTIONS='--max-old-space-size=8192' npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "yalc:watch": "NODE_OPTIONS='--max-old-space-size=4096' nodemon --watch src --watch tsconfig.json --watch tsup.config.ts --watch tailwind.config.ts --watch package.json -e ts,tsx,json,css --ignore dist --ignore node_modules --ignore '*.lock' --ignore .yalc --ignore yalc.lock --exec 'rm -rf dist && tsup && tsc -p tsconfig.declarations.json && yalc push --changed ${YALC_STORE_FOLDER:+--store-folder \"$YALC_STORE_FOLDER\"}'",
    "yalc:push": "yalc push ${YALC_STORE_FOLDER:+--store-folder \"$YALC_STORE_FOLDER\"}",
    "yalc:publish": "yalc publish ${YALC_STORE_FOLDER:+--store-folder \"$YALC_STORE_FOLDER\"}",
    "generate:icons": "node scripts/generate-icons.mjs",
    "format": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint:config-smoke": "node eslint-config/smoke.mjs",
    "lint:cycles": "eslint . --config eslint.cycles.mjs --no-cache --max-warnings 0",
    "lint:types": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --config eslint.types.mjs --no-cache --max-warnings 0",
    "format:fix": "prettier --write .",
    "verify": "npm run lint:config-smoke && npm run lint && npm run type-check && npm run lint:types && npm run test:run",
    "prepare": "cd .. && husky openframe-frontend-core/.husky"
  },
