<?xml version="1.0" encoding="UTF-8"?>
<included debug="true" scan="false">
    <!-- Console Appender -->
    <appender name="ConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [${SPRING_APP_NAME}] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Console (stdout) only, no file appenders: the deployment's log collector (e.g. Alloy -> Loki)
         must scrape container stdout and own retention. See README.md in this directory. -->
    <root level="info">
        <appender-ref ref="ConsoleAppender" />
    </root>
</included>
