<?xml version="1.0" encoding="UTF-8"?>
<included debug="true" scan="false">
    <!-- Console Appender in logfmt -->
    <appender name="ConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>ts=%d{yyyy-MM-dd'T'HH:mm:ss.SSSX} level=%-5level service=${SPRING_APP_NAME} traceId=%X{traceId:-} spanId=%X{spanId:-} logger=%logger{36} thread=%thread msg="%replace(%msg){'\r?\n',' '}" stack="%replace(%ex){'\r?\n',' | '}"%n</pattern>
        </encoder>
    </appender>

    <!-- Console (stdout) only, no file appenders: the deployment's log collector (e.g. Alloy -> Loki)
         must scrape container stdout and own retention. See README.md in this directory. -->
    <root level="info">
        <appender-ref ref="ConsoleAppender" />
    </root>
</included>

