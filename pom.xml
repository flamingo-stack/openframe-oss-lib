<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.openframe.oss</groupId>
    <artifactId>openframe-oss-lib</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>OpenFrame OSS Libraries</name>
    <description>Parent POM for OpenFrame OSS shared libraries with unified versioning.</description>
    <url>https://github.com/flamingo-stack/openframe-oss-lib</url>

    <properties>
        <revision>6.32.0</revision>
        <java.version>25</java.version>
        <lombok.version>1.18.48</lombok.version>
        <spring-data-mongodb.version>4.2.0</spring-data-mongodb.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <pinot.version>1.5.1</pinot.version>
        <nats.version>0.6.2+3.5</nats.version>
        <jjwt.version>0.11.5</jjwt.version>
        <jsonwebtoken.version>0.11.5</jsonwebtoken.version>
        <netflix.dgs.version>12.1.0</netflix.dgs.version>
        <spring-retry.version>2.0.13</spring-retry.version>
        <!-- DGS 12 needs Jackson3JsonProvider (json-path 3); the Spring Boot 4.1 BOM still manages 2.10 -->
        <json-path.version>3.0.0</json-path.version>
        <!-- Security overrides on top of the Spring Boot BOM: versions with fixes for HIGH/CRITICAL CVEs flagged by Trivy.
             Jackson stays on the BOM's minor line: 3.2 rejects the chat MessageData type id / type property overlap. -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <tomcat.version>11.0.26</tomcat.version>
        <freemarker.version>2.3.35</freemarker.version>
        <plexus-utils.version>3.6.2</plexus-utils.version>
        <bcprov-lts8on.version>2.73.13</bcprov-lts8on.version>
        <libthrift.version>0.25.0</libthrift.version>
        <async-http-client.version>3.0.14</async-http-client.version>
        <lz4-java.version>1.8.1</lz4-java.version>
        <kafka-lz4-java.version>1.12.0</kafka-lz4-java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>openframe-exception</module>
        <module>openframe-core</module>
        <module>openframe-core-crypto</module>
        <module>openframe-data-mongo-common</module>
        <module>openframe-data-mongo-sync</module>
        <module>openframe-machine-delivery</module>
        <module>openframe-data-mongo-reactive</module>
        <module>openframe-data-redis</module>
        <module>openframe-presence</module>
        <module>openframe-notification-mail</module>
        <module>openframe-notification-core</module>
        <module>openframe-data-kafka</module>
        <module>openframe-api-lib</module>
        <module>openframe-data-cassandra</module>
        <module>openframe-data-pinot</module>
        <module>openframe-data-loki</module>
        <module>openframe-data-nats</module>
        <module>openframe-data-device-aspect</module>
        <module>openframe-data-timeentry-aspect</module>
        <module>openframe-tool-agent-nats-installation</module>
        <module>openframe-security-core</module>
        <module>openframe-authorization-service-core</module>
        <module>openframe-client-core</module>
        <module>openframe-api-service-core</module>
        <module>openframe-management-service-core</module>
        <module>openframe-pinot-initializer</module>
        <module>openframe-debezium-initializer</module>
        <module>sdk/fleetmdm</module>
        <module>openframe-security-oauth</module>
        <module>openframe-idp-configuration</module>
        <module>openframe-config-core</module>
        <module>openframe-external-api-service-core</module>
        <module>openframe-stream-service-core</module>
        <module>openframe-gateway-service-core</module>
        <module>openframe-test-service-core</module>
        <module>openframe-fe-feature-flags</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-exception</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-core-crypto</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-mongo-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-mongo-sync</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-mongo-reactive</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-presence</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-notification-mail</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-notification-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-machine-delivery</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-kafka</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-api-lib</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-cassandra</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-pinot</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-loki</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-nats</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-device-aspect</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-data-timeentry-aspect</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-tool-agent-nats-installation</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-security-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-security-oauth</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-client-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-management-service-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-pinot-initializer</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-debezium-initializer</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>openframe-idp-configuration</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.openframe.oss</groupId>
                <artifactId>fleetmdm</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- External dependency versions used by modules -->
            <!-- Pulled in by mongock-runner-core via maven-artifact; not managed by Spring Boot -->
            <dependency>
                <groupId>org.codehaus.plexus</groupId>
                <artifactId>plexus-utils</artifactId>
                <version>${plexus-utils.version}</version>
            </dependency>
            <!-- Pulled in by jnats (nats-spring-cloud-stream-binder) -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-lts8on</artifactId>
                <version>${bcprov-lts8on.version}</version>
            </dependency>
            <!-- No longer managed by Spring Boot 4; @Recover has no counterpart in Spring Framework 7 retry -->
            <dependency>
                <groupId>org.springframework.retry</groupId>
                <artifactId>spring-retry</artifactId>
                <version>${spring-retry.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pinot</groupId>
                <artifactId>pinot-java-client</artifactId>
                <version>${pinot.version}</version>
            </dependency>
            <!-- Transitives of pinot-java-client, pinned past HIGH CVEs in the versions it brings -->
            <dependency>
                <groupId>org.apache.thrift</groupId>
                <artifactId>libthrift</artifactId>
                <version>${libthrift.version}</version>
            </dependency>
            <dependency>
                <groupId>org.asynchttpclient</groupId>
                <artifactId>async-http-client</artifactId>
                <version>${async-http-client.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <!-- Transitive of kafka-clients, pinned past a HIGH CVE in the version it brings -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${kafka-lz4-java.version}</version>
            </dependency>
            <dependency>
                <groupId>io.nats</groupId>
                <artifactId>nats-spring-cloud-stream-binder</artifactId>
                <version>${nats.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jsonwebtoken.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <scm>
        <url>https://github.com/flamingo-stack/openframe-oss-lib</url>
        <connection>scm:git:https://github.com/flamingo-stack/openframe-oss-lib.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/flamingo-stack/openframe-oss-lib.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/Test*.java</include>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*TestCase.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <!-- JDK 23+ no longer discovers annotation processors on the classpath; Lombok must be listed -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub flamingo-stack Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/flamingo-stack/openframe-oss-lib</url>
        </repository>
    </distributionManagement>
</project>
