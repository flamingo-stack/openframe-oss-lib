#!/usr/bin/env bash
# OpenFrame Rust crates: run every crate's clippy target (deny warnings) before pushing,
# since one crate builds on another. Only fires when the pushed commits touch Rust under
# clients/; skips gracefully without cargo or make so non-Rust contributors are not blocked.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"

# Collect files changed in the commits being pushed (reads refs on stdin).
changed=""
while read -r _local_ref local_oid _remote_ref remote_oid; do
    [ "$local_oid" = "$zero" ] && continue
    if [ "$remote_oid" = "$zero" ]; then
        base="$(git merge-base origin/main "$local_oid" 2>/dev/null || echo "$local_oid")"
    else
        base="$remote_oid"
    fi
    changed+="$(git diff --name-only "$base".."$local_oid" -- 'clients/' 2>/dev/null || true)"$'\n'
done

if ! echo "$changed" | grep -qE '\.(rs|toml)$'; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1 || ! command -v make >/dev/null 2>&1; then
    echo "[pre-push] cargo or make not found; skipping Rust clippy check." >&2
    exit 0
fi

for manifest in "$root"/clients/*/Cargo.toml; do
    crate="$(dirname "$manifest")"
    echo "[pre-push] $(basename "$crate"): make clippy"
    make -C "$crate" clippy
done
