#!/usr/bin/env bash
# OpenFrame Rust crates: verify formatting before committing.
# Only fires for the crates under clients/ whose Rust sources are staged.
set -euo pipefail

crates="$(git diff --cached --name-only --diff-filter=ACMR | sed -nE 's#^clients/([^/]+)/.*\.rs$#\1#p' | sort -u)"
if [ -z "$crates" ]; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "[pre-commit] cargo not found; skipping Rust fmt check." >&2
    exit 0
fi

root="$(git rev-parse --show-toplevel)"
for crate in $crates; do
    cd "$root/clients/$crate"
    echo "[pre-commit] $crate: cargo fmt --all -- --check"
    cargo fmt --all -- --check
done
