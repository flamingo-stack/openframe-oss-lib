<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openframe.oss</groupId>
        <artifactId>openframe-oss-lib</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>openframe-test-service-core</artifactId>
    <packaging>jar</packaging>
    <name>OpenFrame Test Service Core</name>
    <description>Shared dependencies and core for Test service</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versions Spring Boot does not manage; everything else comes from its BOM -->
        <rest-assured.version>6.0.1</rest-assured.version>
        <datafaker.version>2.1.0</datafaker.version>
        <allure.version>2.25.0</allure.version>
        <allure-maven.version>2.12.0</allure-maven.version>
        <maven-surefire.version>3.6.0</maven-surefire.version>
        <maven-failsafe.version>3.2.3</maven-failsafe.version>
        <maven-compiler.version>3.13.0</maven-compiler.version>
        <slack.version>1.40.3</slack.version>
        <playwright.version>1.44.0</playwright.version>
        <sshj.version>0.38.0</sshj.version>
    </properties>

    <dependencies>
        <!-- ========== Core Testing Dependencies ========== -->

        <!--Mongo DB connection -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
        </dependency>

        <!-- Redis connection -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>
        
        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
        </dependency>

        <!-- REST Assured for API Testing -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- AssertJ for Fluent Assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>

        <!-- ========== JSON Processing ========== -->
        
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ========== Test Data Generation ========== -->
        
        <!-- Faker for generating test data -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>
        
        <!-- ========== Utilities ========== -->
        
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ========== Logging ========== -->
        
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- ========== Reporting ========== -->

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- ========== Notifications ========== -->

        <dependency>
            <groupId>com.slack.api</groupId>
            <artifactId>slack-api-client</artifactId>
            <version>${slack.version}</version>
        </dependency>

        <!-- ========== SSH (channel B — verify device state on the box) ========== -->

        <dependency>
            <groupId>com.hierynomus</groupId>
            <artifactId>sshj</artifactId>
            <version>${sshj.version}</version>
        </dependency>

        <!-- sshj needs BouncyCastle for modern key-exchange / cipher suites used by OpenSSH servers -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Opt-in profile for running the AI E2E cases from the CLI. These tests live in src/main/java
          (this suite's custom-runner convention), so the default surefire scan of target/test-classes
          never finds them. This profile points surefire at the main output dir and restricts it to the
          tests/ai package, so it will not sweep the rest of the suite. Default `mvn` builds and the
          runner service are unaffected because the profile is inactive unless requested with -Pai-test.

          Usage (with TARGET_* + suite env exported, see set-dev-env.sh):
            mvn test -Pai-test                                            # all tests/ai cases
            mvn test -Pai-test -Dtest=MingoDeviceTest#testFileCreate       # one method
        -->
        <!--
          Opt-in profile for the External API suite (the X-API-Key surface at /external-api/**).
          Same mechanics as ai-test below: these tests live in src/main/java, so surefire is pointed at
          the main output dir and restricted to the tests/external package.

          Needs no credential of its own: the suite mints an API key over POST /api/api-keys as the
          admin user in the usual suite env, and deletes it again when the run ends. Set
          TEST_EXTERNAL_API_KEY only to pin a specific pre-existing key; one supplied that way is used
          as-is and never deleted. With no admin credentials at all every case reports as skipped rather
          than failing.

          Note the suite paces itself to whatever per-minute rate limit the gateway advertises for the key,
          so a full run can be dominated by that wait rather than by the API. See RateLimitRetryFilter.

          Usage:
            mvn test -Pexternal-api-test                                   # whole suite
            mvn test -Pexternal-api-test -Dtest=ExternalTicketsTest        # one class
        -->
        <profile>
            <id>external-api-test</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven-surefire.version}</version>
                        <configuration>
                            <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
                            <includes>
                                <include>**/tests/external/*Test.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>ai-test</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven-surefire.version}</version>
                        <configuration>
                            <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
                            <includes>
                                <include>**/tests/ai/*Test.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>