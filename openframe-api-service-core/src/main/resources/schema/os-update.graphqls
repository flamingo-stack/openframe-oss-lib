extend type Query {
    """OS update state as the device agent last reported it. Null = the device never sent an OS report.
    Unknown machineId → DEVICE_NOT_FOUND."""
    deviceOsState(machineId: String!): DeviceOsState

    """OS updates the device's OS currently offers it, newest discovered first, then by title.
    Unknown machineId → DEVICE_NOT_FOUND; a device that never reported → empty list."""
    deviceOsUpdates(machineId: String!): [DeviceOsUpdate!]!

    """OS updates the device installed or failed to install, newest first.
    `first`: 1-100, default 20. Unknown machineId → DEVICE_NOT_FOUND."""
    deviceOsUpdateHistory(machineId: String!, first: Int, after: String): DeviceOsUpdateHistoryConnection!
}

type DeviceOsState {
    osVersion: String
    osBuild: String
    restartPending: Boolean
    """When the device first reported the restart that is still pending."""
    restartPendingSince: Instant
    """Last successful scan for updates. Null = never scanned successfully."""
    lastScanAt: Instant
    """Error of the last scan, as the OS gave it. Null after a successful scan."""
    lastScanError: String
    lastInstalledAt: Instant
    managementState: OsUpdateManagementState
    managedElsewhereReason: OsUpdateManagedElsewhereReason
    observedReason: OsUpdateObservedReason
    authorization: OsUpdateAuthorization
    receivedAt: Instant!
}

enum OsUpdateManagementState {
    MANAGED
    MANAGED_ELSEWHERE
    OBSERVED
}

enum OsUpdateManagedElsewhereReason {
    GPO
    WSUS
    MDM
    CONFIGMGR
}

enum OsUpdateObservedReason {
    HOME_EDITION
    WRITE_FILTER
}

enum OsUpdateAuthorization {
    AUTHORIZED
    NOT_AUTHORIZED
    NOT_REQUIRED
}

type DeviceOsUpdate {
    updateKey: String!
    title: String!
    version: String
    kbArticleIds: [String!]!
    """The vendor's own severity. Null = the vendor gave none."""
    severity: OsUpdateSeverity
    """The vendor's category names, verbatim."""
    categories: [String!]!
    """An optional or preview update."""
    browseOnly: Boolean
    """When the vendor last published the update to devices, as the agent reports it; not the release date."""
    publishedAt: Instant
    sizeBytes: Long
    restartBehaviour: OsUpdateRestartBehaviour
    discoveredAt: Instant!
}

enum OsUpdateSeverity {
    CRITICAL
    IMPORTANT
    MODERATE
    LOW
}

enum OsUpdateRestartBehaviour {
    NEVER
    MAY_REQUIRE
    ALWAYS
}

type DeviceOsUpdateHistoryConnection {
    edges: [DeviceOsUpdateHistoryEdge!]!
    pageInfo: PageInfo!
}

type DeviceOsUpdateHistoryEdge {
    node: DeviceOsUpdateHistoryEntry!
    cursor: String!
}

type DeviceOsUpdateHistoryEntry {
    updateKey: String
    title: String!
    version: String
    installedAt: Instant!
    operation: OsUpdateOperation
    result: OsUpdateInstallResult
    """Windows HRESULT, verbatim."""
    errorCode: String
}

enum OsUpdateOperation {
    INSTALL
    UNINSTALL
}

enum OsUpdateInstallResult {
    SUCCEEDED
    SUCCEEDED_WITH_ERRORS
    FAILED
    ABORTED
}
