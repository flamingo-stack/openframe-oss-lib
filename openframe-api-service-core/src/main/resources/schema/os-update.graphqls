extend type Query {
    """OS and update state as the device agent last reported it. Null = the device never sent an OS report.
    Unknown machineId → DEVICE_NOT_FOUND."""
    deviceOsState(machineId: String!): DeviceOsState

    """OS updates waiting on the device, newest discovered first. An empty list alone does not mean "up to date":
    read `deviceOsState.patchState` and `scanState`. Always empty for a device we cannot manage
    (`deviceOsState.manageability.state` NOT_MANAGEABLE). Unknown machineId → DEVICE_NOT_FOUND."""
    deviceOsPendingUpdates(machineId: String!): [DeviceOsPendingUpdate!]!

    """OS updates the device installed or failed to install, newest first. Windows only: a Mac reports no history.
    `first`: 1-100, default 20. Unknown machineId → DEVICE_NOT_FOUND."""
    deviceOsUpdateHistory(machineId: String!, first: Int, after: String): DeviceOsUpdateHistoryConnection!

    """OS updates the devices of the tenant reported, one row per update, the latest first seen first.
    `first`: 1-100, default 20."""
    osUpdates(filter: OsUpdateFilterInput, first: Int, after: String): OsUpdateConnection!

    """One OS update. Null = the tenant has no such update."""
    osUpdate(id: ID!): OsUpdate

    """Devices of one OS update in one status. PENDING: newest discovered first. INSTALLED: latest installed first,
    Windows only. `organizationIds`: only devices of these organizations; omitted or empty = every organization.
    `first`: 1-100, default 20. Unknown osUpdateId → OS_UPDATE_NOT_FOUND."""
    osUpdateDevices(osUpdateId: ID!, status: OsUpdateDeviceStatus!, organizationIds: [String!], first: Int,
        after: String): OsUpdateDeviceConnection!

    """The numbers of the cards above the OS update list. Windows devices only; devices we cannot manage are not
    counted. `organizationIds`: only these customers, the same as in the list filter; omitted or empty = every
    customer."""
    osUpdateSummary(organizationIds: [String!]): OsUpdateSummary!
}

type OsUpdateSummary {
    """Windows devices that report their OS and can be managed."""
    deviceCount: Int!
    """Of them, the devices with no pending update they may already install."""
    currentDeviceCount: Int!
    """Devices with a pending update past its hard restart deadline."""
    overdueDeviceCount: Int!
    """Of the overdue devices, the ones that are not online now."""
    overdueOfflineDeviceCount: Int!
    """Devices that installed an update and wait for a restart."""
    restartPendingDeviceCount: Int!
    """Updates with the status HELD at a customer and pending on a device of that customer."""
    heldUpdateCount: Int!
}

input OsUpdateFilterInput {
    platform: OsPlatform
    """Any of these. An update stored before classification existed has none and matches no value."""
    classifications: [OsUpdateClassification!]
    """Part of the display name, of a KB article id or of a CVE id. Case-insensitive."""
    search: String
    """Only updates pending on or installed by a device of these organizations, and both device counts count only
    those devices. Omitted or empty = every organization; organizations without devices = no update."""
    organizationIds: [String!]
    """Only updates with any of these statuses at a customer; with `organizationIds`, at one of those customers.
    Windows updates only. Omitted or empty = every update."""
    customerStatuses: [OsUpdateCustomerStatus!]
}

type OsUpdateConnection {
    edges: [OsUpdateEdge!]!
    pageInfo: PageInfo!
}

type OsUpdateEdge {
    node: OsUpdate!
    cursor: String!
}

"""An OS update as the first device of the tenant that reported it described it."""
type OsUpdate {
    id: ID!
    platform: OsPlatform!
    """Opaque id of the update, as the OS names it."""
    identifier: String!
    displayName: String
    displayVersion: String
    kbArticleIds: [String!]!
    """The vendor's own severity, as the device reported it or else from Microsoft's bulletin. Null = the vendor
    gave none; always null on macOS for now."""
    severity: OsUpdateSeverity
    """The vendor's category names, verbatim, in the language of the reporting device."""
    categories: [String!]!
    """The vendor's category ids. The same on every device, whatever its language."""
    categoryIds: [String!]!
    """Windows only."""
    updateType: OsUpdateType
    """Our class of the update. Null = stored before classification existed."""
    classification: OsUpdateClassification
    """As the device reported them, or else from Microsoft's bulletin."""
    cveIds: [String!]!
    publishedAt: Instant
    sizeBytes: Long
    rebootBehavior: OsUpdateRebootBehavior
    """An optional or preview update."""
    browseOnly: Boolean
    """A CVE of the update is known to be exploited, by Microsoft's bulletin or the CISA KEV catalog. Null = no CVE
    of the update is known."""
    exploited: Boolean
    """When the update was last checked against the vendor's bulletin, with or without data. Null = not checked yet."""
    enrichedAt: Instant
    """When a device of the tenant first reported the update."""
    firstSeenAt: Instant!

    """Devices that list the update as pending now. Devices we cannot manage (manageability NOT_MANAGEABLE) are
    not counted."""
    pendingDeviceCount: Int!
    """Devices that installed the update successfully. Windows only, and only installs of the last 30 days: the
    stored history goes no further. A device that installed the update and waits for a restart may be counted
    as pending too."""
    installedDeviceCount: Int!
    """The distinct statuses of the update over the customers that have a device the update is pending on or
    installed by; in a list filtered by organizations, over those customers only. Empty for a macOS update."""
    customerStatuses: [OsUpdateCustomerStatus!]!
}

"""Set once, when the update is first stored. The rule is a first draft and Windows only: every macOS update is
OTHER."""
enum OsUpdateClassification {
    SECURITY
    QUALITY
    PREVIEW
    OS_VERSION
    DRIVER
    OTHER
}

enum OsUpdateDeviceStatus {
    PENDING
    INSTALLED
}

type OsUpdateDeviceConnection {
    edges: [OsUpdateDeviceEdge!]!
    pageInfo: PageInfo!
}

type OsUpdateDeviceEdge {
    node: OsUpdateDevice!
    cursor: String!
}

type OsUpdateDevice {
    machineId: String!
    status: OsUpdateDeviceStatus!
    """PENDING only: when the device first reported the update."""
    discoveredAt: Instant
    """INSTALLED only: the device's latest successful install of the update."""
    installedAt: Instant
    """Null = the device is no longer in the tenant."""
    machine: Machine
}

type DeviceOsState {
    platform: OsPlatform
    osVersion: String
    osBuild: String
    osProductName: String

    """How current the OS's own check for updates is. UNKNOWN or null = we do not know what is pending."""
    scanState: OsUpdateScanState
    """Last successful check by the OS. Null = never."""
    lastScanAt: Instant
    """Anything but CONFIRMED: the device could not read its updates, the pending updates are from an earlier report."""
    pendingUpdatesConfidence: OsUpdateListConfidence
    """UNKNOWN is its own answer, neither up to date nor behind."""
    patchState: OsPatchState

    """UNKNOWN = may be pending. A Mac never answers NO."""
    rebootPending: OsRebootPending
    """When the device first reported the reboot that is still pending."""
    rebootPendingSince: Instant

    manageability: OsUpdateManageability
    """Null = the agent has not determined it."""
    osUpdateAuthorization: OsUpdateAuthorization
    lastOsInstall: LastOsInstall

    """When the agent built the report."""
    reportedAt: Instant
    receivedAt: Instant!
}

enum OsPlatform {
    WINDOWS
    MACOS
}

enum OsUpdateScanState {
    FRESH
    AGING
    STALE
    UNKNOWN
}

enum OsUpdateListConfidence {
    CONFIRMED
    UNCONFIRMED
    RETAINED
    UNREADABLE
    TOO_LARGE
}

enum OsPatchState {
    UP_TO_DATE
    UPDATES_AVAILABLE
    UNKNOWN
}

enum OsRebootPending {
    YES
    NO
    UNKNOWN
}

type OsUpdateManageability {
    state: OsUpdateManageabilityState
    """Why the device is not manageable, as the agent names it (WSUS, GROUP_POLICY, MDM, ...). The list is open:
    show an unknown reason as it is."""
    reasons: [String!]!
}

enum OsUpdateManageabilityState {
    MANAGEABLE
    NOT_MANAGEABLE
}

enum OsUpdateAuthorization {
    AUTHORIZED
    NOT_AUTHORIZED
    NOT_REQUIRED
}

type LastOsInstall {
    identifier: String
    displayName: String
    displayVersion: String
    installedAt: Instant!
}

type DeviceOsPendingUpdate {
    """Opaque id of the update, as the OS names it."""
    identifier: String!
    displayName: String
    displayVersion: String
    kbArticleIds: [String!]!
    """The vendor's own severity, as the device reported it or else from Microsoft's bulletin. Null = the vendor
    gave none; always null on macOS for now."""
    severity: OsUpdateSeverity
    """The vendor's category names, verbatim."""
    categories: [String!]!
    """The vendor's category ids. The same on every device, whatever its language."""
    categoryIds: [String!]!
    """Windows only."""
    updateType: OsUpdateType
    """Our class of the update. Null = stored before classification existed."""
    classification: OsUpdateClassification
    """As the device reported them, or else from Microsoft's bulletin."""
    cveIds: [String!]!
    publishedAt: Instant
    sizeBytes: Long
    rebootBehavior: OsUpdateRebootBehavior
    """An optional or preview update."""
    browseOnly: Boolean
    """A CVE of the update is known to be exploited, by Microsoft's bulletin or the CISA KEV catalog. Null = no CVE
    of the update is known."""
    exploited: Boolean
    """When the update was last checked against the vendor's bulletin, with or without data. Null = not checked yet."""
    enrichedAt: Instant

    """When this device first reported the update. Does not move while the update stays pending."""
    discoveredAt: Instant!
    downloaded: Boolean
    macosPresence: MacosUpdatePresence
    """Null = no policy rolls the update out to this device: no policy covers the device, or the policy has no rule
    for the urgency of the update."""
    rolloutState: DeviceOsUpdateRolloutState
}

enum OsUpdateSeverity {
    CRITICAL
    IMPORTANT
    MODERATE
    LOW
}

enum OsUpdateType {
    SOFTWARE
    DRIVER
}

enum OsUpdateRebootBehavior {
    NEVER
    MAY_REQUIRE
    ALWAYS
}

enum MacosUpdatePresence {
    FRESH
    HELD_OVER
}

type DeviceOsUpdateHistoryConnection {
    edges: [DeviceOsUpdateHistoryEdge!]!
    pageInfo: PageInfo!
}

type DeviceOsUpdateHistoryEdge {
    node: DeviceOsUpdateHistoryEntry!
    cursor: String!
}

type DeviceOsUpdateHistoryEntry {
    identifier: String!
    title: String
    installedAt: Instant!
    operation: OsUpdateOperation
    result: OsUpdateInstallResult
    """Windows HRESULT as hex. Null on success."""
    errorCode: String
}

enum OsUpdateOperation {
    INSTALL
    UNINSTALL
}

enum OsUpdateInstallResult {
    SUCCEEDED
    SUCCEEDED_WITH_ERRORS
    FAILED
    ABORTED
}
