extend type Query {
    logFilters(filter: LogFilterInput): LogFilters!

    logs(
        filter: LogFilterInput
        first: Int
        after: String
        last: Int
        before: String
        search: String
        sort: LogSortInput
    ): LogConnection!

    # Get full audit details from Loki when user clicks on a audit
    # Requires the complete key of the event for an exact Loki lookup
    logDetails(
        ingestDay: String!      # YYYY-MM-DD format
        toolType: String!       # Tool type (meshcentral, fleet-mdm, etc.)
        eventType: String!      # Event type (login, logout, script, etc.)
        timestamp: Instant!     # Timestamp of the audit
        toolEventId: String!    # Tool event ID
    ): LogDetails
}

type LogFilters {
    toolTypes: [String!]!
    eventTypes: [String!]!
    severities: [String!]!
    organizations: [OrganizationFilterOption!]!
}

type OrganizationFilterOption {
    id: String!    # organizationId (for filtering)
    name: String!  # organizationName (for display)
}

input LogFilterInput {
    startDate: Date        # Date scalar - single select (day granularity)
    endDate: Date          # Date scalar - single select (day granularity)
    # Inclusive timestamp range (millisecond precision, UTC ISO-8601 Instant).
    # Independent of startDate/endDate and of each other: only from, only to, or both.
    timestampFrom: Instant # Inclusive lower bound on the log timestamp
    timestampTo: Instant   # Inclusive upper bound on the log timestamp
    eventTypes: [String!]  # Multiselect (not array)
    toolTypes: [String!]   # Multiselect (not array)
    severities: [String!]  # Multiselect (not array)
    organizationIds: [String!]  # Organization filter (multiselect)
    deviceId: String       # Single device filter (exact matching)
}

# Sortable fields for logs. Currently only the timestamp is sortable.
enum LogSortField {
    TIMESTAMP
}

input LogSortInput {
    field: LogSortField!       # currently TIMESTAMP only
    direction: SortDirection!  # ASC = oldest->newest, DESC = newest->oldest
}

type LogConnection {
    edges: [LogEdge!]!
    pageInfo: PageInfo!
}

type LogEdge {
    node: LogEvent!
    cursor: String!
}

type LogEvent implements Node {
    id: ID!
    toolEventId: String!
    eventType: String!
    ingestDay: String!
    toolType: String!
    severity: String!
    userId: String
    deviceId: String
    hostname: String
    nickname: String
    executionSource: String
    scriptCreationSource: String
    organizationId: String
    organizationName: String
    summary: String
    timestamp: Instant!
}

# Full audit details from Loki
type LogDetails implements Node {
    id: ID!
    toolEventId: String!
    eventType: String!
    ingestDay: String!
    toolType: String!
    severity: String!
    userId: String
    deviceId: String
    hostname: String
    nickname: String
    executionSource: String
    scriptCreationSource: String
    organizationId: String
    organizationName: String
    message: String
    timestamp: Instant!
    # Details as JSON string
    details: String
}
