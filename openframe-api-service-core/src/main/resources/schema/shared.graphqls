# Shared GraphQL schema definitions
# This file contains common types and base types used across multiple schemas

# The api subgraph's only federation @link: an assembled schema allows one, and every file api loads may use these.
extend schema @link(url: "https://specs.apollo.dev/federation/v2.5", import: ["@key", "@shareable", "@override"])

# Base types that can be extended by other schemas
interface Node {
    id: ID!
}

type Query {
    # Relay Node interface queries; in the federated supergraph api answers them for every subgraph's nodes
    node(id: ID!): Node @override(from: "ai-agent")
    nodes(ids: [ID!]!): [Node]! @override(from: "ai-agent")
}

type Mutation {
    # Base Mutation type - extended by other schemas
}

# Common scalar types
scalar Instant
scalar Date  # Date in yyyy-MM-dd format
scalar Long  # 64-bit integer for large numbers like file sizes
scalar JSON  # Opaque JSON value (maps/lists serialized as-is); not accepted as an argument literal

# Relay Connection Spec page info
type PageInfo @shareable {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}

enum ToolType {
    MESHCENTRAL
    FLEET_MDM
    OPENFRAME_RMM
}

# Sorting support
enum SortDirection {
    ASC
    DESC
}

input SortInput {
    field: String
    direction: SortDirection
}

# Half-open date range filter. Period covers [startDate, endDate) — endDate day itself is NOT included.
input DateRangeInput {
    startDate: Date!
    endDate: Date!
}

# Generic mutation primitives
type MutationError {
    field: [String!]
    message: String!
}

type MutationDeletePayload {
    deletedId: ID
    userErrors: [MutationError!]!
}

input MutationDeleteInput {
    id: ID!
}
