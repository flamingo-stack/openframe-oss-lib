extend type Query {
    """The OS update policies of the tenant, the earliest created first."""
    osUpdatePolicies: [OsUpdatePolicy!]!

    osUpdatePolicy(id: ID!): OsUpdatePolicy

    """The policy the device follows: the most specific one that covers it, in the order device, device tag,
    customer, tenant. Null = no policy covers the device, or the device cannot be managed."""
    deviceOsUpdatePolicy(machineId: String!): OsUpdatePolicy

    """The technicians' decisions on one update that stand on top of the policies."""
    osUpdateOverrides(osUpdateId: ID!): [OsUpdateOverride!]!
}

extend type Mutation {
    """Refused with OS_UPDATE_POLICY_CONFLICT when a device would fall under this policy and under another one of
    the same target type; the message names the other policy and the devices."""
    createOsUpdatePolicy(input: OsUpdatePolicyInput!): OsUpdatePolicy!

    """Replaces the policy as a whole. Refused like createOsUpdatePolicy."""
    updateOsUpdatePolicy(id: ID!, input: OsUpdatePolicyInput!): OsUpdatePolicy!

    deleteOsUpdatePolicy(id: ID!): ID!

    """Approves, holds or rejects one update on top of the policies. Replaces the earlier decision of the same
    scope."""
    setOsUpdateOverride(input: OsUpdateOverrideInput!): OsUpdateOverride!

    """Takes the decision of that scope back, so the policy decides again. False = there was none."""
    removeOsUpdateOverride(osUpdateId: ID!, organizationId: String, machineId: String): Boolean!
}

type OsUpdatePolicy {
    id: ID!
    name: String!
    target: OsUpdatePolicyTarget!
    """One rule per urgency. An update of an urgency without a rule is not rolled out by the policy."""
    rolloutRules: [OsUpdateRolloutRule!]!
    """One per urgency that has a rollout rule."""
    restartDeadlines: [OsUpdateRestartDeadline!]!
    """The pilot ring: the devices with this tag are the first to get an update under PILOT_THEN_EVERYONE."""
    pilotTagId: ID
    createdAt: Instant!
    updatedAt: Instant!
}

"""Which devices the policy covers. A device follows the most specific policy that covers it: DEVICE, then
DEVICE_TAG, then CUSTOMER, then TENANT."""
type OsUpdatePolicyTarget {
    type: OsUpdatePolicyTargetType!
    """Set for CUSTOMER."""
    organizationId: String
    """Set for DEVICE_TAG: a device with any of the tags."""
    tagIds: [ID!]
    """Set for DEVICE."""
    machineIds: [String!]
}

enum OsUpdatePolicyTargetType {
    TENANT
    CUSTOMER
    DEVICE_TAG
    DEVICE
}

"""CRITICAL_SECURITY: a security update of Critical severity, or one with a CVE known to be exploited.
OTHER_SECURITY: every other security update. QUALITY: a quality update."""
enum OsUpdateUrgency {
    CRITICAL_SECURITY
    OTHER_SECURITY
    QUALITY
}

type OsUpdateRolloutRule {
    urgency: OsUpdateUrgency!
    mode: OsUpdateRolloutMode!
    """Days from the vendor's release to the first devices: the pilot ring under PILOT_THEN_EVERYONE, every device
    under EVERYONE_AT_ONCE. Null under HOLD."""
    daysAfterRelease: Int
    """Days from the pilot ring to every other device. Set under PILOT_THEN_EVERYONE only."""
    daysLaterToEveryone: Int
}

"""HOLD: nothing installs until a technician approves the update."""
enum OsUpdateRolloutMode {
    PILOT_THEN_EVERYONE
    EVERYONE_AT_ONCE
    HOLD
}

"""Days from the moment the device may install the update, or from the day it first reported the update when
that is later."""
type OsUpdateRestartDeadline {
    urgency: OsUpdateUrgency!
    """Until then the restart dialog waits while the user is in a meeting, presenting or has Do Not Disturb on."""
    focusDays: Int!
    """From then the user cannot defer the restart any more."""
    softDays: Int!
    """From then the device restarts on its own after a short notice."""
    hardDays: Int!
}

input OsUpdatePolicyInput {
    name: String!
    target: OsUpdatePolicyTargetInput!
    rolloutRules: [OsUpdateRolloutRuleInput!]!
    restartDeadlines: [OsUpdateRestartDeadlineInput!]!
    """Required when a rule uses PILOT_THEN_EVERYONE."""
    pilotTagId: ID
}

input OsUpdatePolicyTargetInput {
    type: OsUpdatePolicyTargetType!
    organizationId: String
    tagIds: [ID!]
    machineIds: [String!]
}

input OsUpdateRolloutRuleInput {
    urgency: OsUpdateUrgency!
    mode: OsUpdateRolloutMode!
    daysAfterRelease: Int
    daysLaterToEveryone: Int
}

input OsUpdateRestartDeadlineInput {
    urgency: OsUpdateUrgency!
    focusDays: Int!
    softDays: Int!
    hardDays: Int!
}

"""A technician's decision on one update. Its scope is one device (machineId), one customer (organizationId) or
every customer (neither). For a device the narrowest scope wins."""
type OsUpdateOverride {
    action: OsUpdateOverrideAction!
    organizationId: String
    machineId: String
    """The user who decided."""
    actedBy: String
    actedAt: Instant!
}

"""APPROVE: the devices may install now, ahead of the policy's days. HOLD and REJECT: the devices do not
install."""
enum OsUpdateOverrideAction {
    APPROVE
    HOLD
    REJECT
}

input OsUpdateOverrideInput {
    osUpdateId: ID!
    action: OsUpdateOverrideAction!
    """Give one of the two, or neither for every customer."""
    organizationId: String
    machineId: String
}

"""What the policy of the device and the technicians' decisions give for one pending update of the device."""
type DeviceOsUpdateRolloutState {
    policyId: ID!
    status: DeviceOsUpdateRolloutStatus!
    """The technician's decision behind the status. Null = the policy decided."""
    overrideAction: OsUpdateOverrideAction
    """From when the device may install the update. Null = it may not: HELD or REJECTED."""
    installFrom: Instant
    """The restart deadlines of this device for this update. Null while installFrom is null."""
    focusAt: Instant
    softAt: Instant
    hardAt: Instant
}

"""SCHEDULED: installFrom is ahead. APPROVED: installFrom has come. HELD: waits for a technician. REJECTED: a
technician rejected the update."""
enum DeviceOsUpdateRolloutStatus {
    SCHEDULED
    APPROVED
    HELD
    REJECTED
}
