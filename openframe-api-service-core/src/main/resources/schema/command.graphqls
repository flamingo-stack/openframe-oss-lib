# RMM ad-hoc command dispatch.
#
# Distinct from scripts: a command is just a raw shell string typed in the
# dashboard. Single runCommand is pure transport — nothing is persisted, the
# executionId only correlates the asynchronous agent response. batchRunCommand
# persists one row per machine, read back via commandExecutions.

extend type Mutation {
    runCommand(input: RunCommandInput!): DispatchResponse!
    batchRunCommand(input: BatchRunCommandInput!): DispatchResponse!
    cancelExecution(input: CancelExecutionInput!): DispatchResponse!
}

extend type Query {
    """Per-machine rows of one batch dispatch (batchRunCommand / installPackage /
    uninstallPackage) — status and, once the agent reports, the execution logs
    (stdout / stderr). Poll until every row is terminal."""
    commandExecutions(executionId: ID!): [CommandExecution!]!
}

type CommandExecution {
    executionId: ID!
    machineId: String!
    command: String!
    shell: ScriptShell!
    privilegeLevel: PrivilegeLevel!
    status: ScriptExecutionStatus!
    dispatchedAt: Instant!
    statusChangedAt: Instant
    finishedAt: Instant
    exitCode: Int
    executionTimeMs: Float
    timedOut: Boolean
    stdout: String
    stdoutTruncated: Boolean
    stderr: String
    stderrTruncated: Boolean
    error: String
}

input RunCommandInput {
    machineId: String!
    shell: ScriptShell!
    command: String!
    privilegeLevel: PrivilegeLevel!
    timeoutSeconds: Int
}

# One command fanned out to several machines under a single executionId.
# Unlike runCommand, the batch is persisted (status PENDING) before dispatch.
input BatchRunCommandInput {
    machineIds: [String!]!
    shell: ScriptShell!
    command: String!
    privilegeLevel: PrivilegeLevel!
    timeoutSeconds: Int
}

enum PrivilegeLevel {
    USER
    ADMIN
}

input CancelExecutionInput {
    machineId: String!
    executionId: ID!
}

type DispatchResponse {
    executionId: ID!
}
