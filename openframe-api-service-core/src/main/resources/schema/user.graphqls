extend type Query {
    # Users of the tenant, ordered by email.
    # search: every whitespace-separated word must match the first name, last name or email
    # (a self-deleted user's placeholder email is not matched).
    users(
        filter: UserFilterInput
        search: String
        # 1-100, default 20
        first: Int
        after: String
    ): UserConnection!

    # Open invitations (not accepted, not revoked), newest first. search matches the email.
    invitations(
        filter: InvitationFilterInput
        search: String
        # 1-100, default 20
        first: Int
        after: String
    ): InvitationConnection!
}

extend type Mutation {
    # One invitation per email, 1-100 emails. An email that cannot be invited (malformed, listed twice,
    # an existing user, a blocked domain) is a userError with field ["emails", "<index>"]; the rest are sent.
    inviteUsers(input: InviteUsersInput!): InviteUsersPayload!

    # Only a pending invitation can be revoked.
    revokeInvitation(input: RevokeInvitationInput!): RevokeInvitationPayload!

    # Only an expired invitation can be resent: a new invitation replaces it and the old one is revoked.
    resendInvitation(input: ResendInvitationInput!): ResendInvitationPayload!

    # A null name is kept.
    updateUser(input: UpdateUserInput!): UpdateUserPayload!

    # Soft delete: DELETED, or SELF_DELETED (anonymized) for your own account. The owner cannot be deleted;
    # transfer ownership first. Deleting a user who is not ACTIVE changes nothing.
    deleteUser(input: DeleteUserInput!): DeleteUserPayload!

    # Owner only: the new owner (an ACTIVE user) becomes OWNER, you become ADMIN.
    transferOwnership(input: TransferOwnershipInput!): TransferOwnershipPayload!
}

type User implements Node {
    id: ID!
    firstName: String
    lastName: String
    email: String
    status: UserStatus
    # Effective roles: an OWNER is an ADMIN too.
    roles: [UserRole!]!
    image: UserImage
}

type UserImage {
    imageUrl: String
    hash: String
}

enum UserStatus {
    ACTIVE
    # Deleted by an admin; personal data is kept and a re-invite revives the account.
    DELETED
    # Deleted by the user; personal data is anonymized.
    SELF_DELETED
}

enum UserRole {
    ADMIN
    OWNER
}

input UserFilterInput {
    # Omit or leave empty for every status.
    statuses: [UserStatus!]
}

type UserConnection {
    edges: [UserEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type UserEdge {
    node: User!
    cursor: String!
}

type Invitation implements Node {
    id: ID!
    email: String!
    roles: [UserRole!]!
    status: InvitationStatus!
    createdAt: Instant
    expiresAt: Instant!
}

enum InvitationStatus {
    PENDING
    # Pending past expiresAt; can be resent.
    EXPIRED
}

input InvitationFilterInput {
    # Omit or leave empty for both.
    statuses: [InvitationStatus!]
}

type InvitationConnection {
    edges: [InvitationEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type InvitationEdge {
    node: Invitation!
    cursor: String!
}

input InviteUsersInput {
    emails: [String!]!
}

type InviteUsersPayload {
    # The invitations sent, in input order.
    invitationEdges: [InvitationEdge!]!
    userErrors: [MutationError!]!
}

input RevokeInvitationInput {
    id: ID!
}

type RevokeInvitationPayload {
    revokedInvitationId: ID!
}

input ResendInvitationInput {
    id: ID!
}

type ResendInvitationPayload {
    # The replacement, with a new id.
    invitationEdge: InvitationEdge!
    revokedInvitationId: ID!
}

input UpdateUserInput {
    id: ID!
    # Up to 128 characters.
    firstName: String
    # Up to 128 characters.
    lastName: String
}

type UpdateUserPayload {
    user: User!
}

input DeleteUserInput {
    id: ID!
}

type DeleteUserPayload {
    user: User!
}

input TransferOwnershipInput {
    newOwnerId: ID!
}

type TransferOwnershipPayload {
    previousOwner: User!
    newOwner: User!
}
