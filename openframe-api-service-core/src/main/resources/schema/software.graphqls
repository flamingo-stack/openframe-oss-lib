# Software inventory (read side, thin proxy over Fleet MDM REST).
#
# The wire contract is stable so the frontend can start binding against it;
# resolvers are gated behind a Conditional-property and only wire up when the
# Software feature is enabled via openframe.rmm.software.enabled=true.

extend type Query {
    """Single software row by id (Relay global id). Null when unknown."""
    software(id: ID!): Software

    """Paginated list of software titles installed across the tenant's fleet.
    One row = one software title (aggregated across devices).
    Sortable fields: name, devicesCount, cveCount, highestSeverity, adoptionCount (default: Fleet order by name).
    An unknown sort field is rejected as a client error (BAD_REQUEST), not a server error."""
    softwares(
        filter: SoftwareFilterInput,
        first: Int,
        after: String,
        last: Int,
        before: String,
        search: String,
        sort: SortInput
    ): SoftwareConnection!

    """Devices that have a given software title installed, with each device's own
    installed version and per-device software status (OUTDATED / SCHEDULED_UPDATE / …),
    who installed it, its adoption and auto-update. Powers the Software → Devices tab.
    Sortable fields: softwareVersion."""
    softwareDevices(
        softwareId: ID!,
        filter: SoftwareOnDeviceFilterInput,
        first: Int,
        after: String,
        last: Int,
        before: String,
        search: String,
        sort: SortInput
    ): SoftwareOnDeviceConnection!

    """CVEs affecting a given software title. Powers the Software → Vulnerabilities tab."""
    softwareVulnerabilities(
        softwareId: ID!,
        filter: SoftwareVulnerabilityFilterInput,
        first: Int,
        after: String,
        last: Int,
        before: String,
        search: String,
        sort: SortInput
    ): SoftwareVulnerabilityConnection!

    """Faceted filter-option counts for the software list — Type / Source / Version-status /
    Vulnerability-severity dropdowns. Mirrors scriptFilters / deviceFilters."""
    softwareFilters(filter: SoftwareFilterInput, search: String): SoftwareFilters!

    """Faceted filter-option counts for a software title's Devices tab — the Status dropdown.
    Mirrors softwareFilters; scoped to the devices that have this software installed."""
    softwareDeviceFilters(softwareId: ID!, filter: SoftwareOnDeviceFilterInput, search: String): SoftwareOnDeviceFilters!

    """Single global CVE record by id (e.g. "CVE-2024-38063"). Null when Fleet has no record.
    Populates the vulnerability detail page — includes affected-software list."""
    vulnerability(cveId: String!): Vulnerability

    """Global list of CVEs across every software title in the tenant's fleet.
    Powers the Vulnerabilities page. One row = one CVE (not one CVE × software)."""
    vulnerabilities(
        filter: VulnerabilityFilterInput,
        first: Int,
        after: String,
        last: Int,
        before: String,
        search: String,
        sort: SortInput
    ): VulnerabilityConnection!

    """Faceted filter options (with live counts) for the vulnerabilities list — the Severity dropdown.
    Same filter/search scope as vulnerabilities; mirrors softwareFilters so the UI can disable a band
    with no matching rows."""
    vulnerabilityFilters(filter: VulnerabilityFilterInput, search: String): VulnerabilityFilters!

    """Devices affected by a given CVE — the hosts that have an affected software version, correlated
    to their OpenFrame Machine. Powers the vulnerability-detail "Devices" table. Each node is a Machine
    (same shape as the top-level `devices` query)."""
    vulnerabilityDevices(
        cveId: String!,
        first: Int,
        after: String,
        last: Int,
        before: String,
        search: String,
        sort: SortInput
    ): DeviceConnection!

    """Software installed on one device. One row = one installed title, the same node as `softwares`.
    Version fields are read in this device's scope: `currentVersion` is the version installed here.
    Sortable fields: name, cveCount, highestSeverity (default: name).
    Unknown machineId → NOT_FOUND; a known device with nothing installed → empty connection."""
    deviceSoftware(
        machineId: String!,
        filter: SoftwareFilterInput,
        first: Int,
        after: String,
        last: Int,
        before: String,
        search: String,
        sort: SortInput
    ): SoftwareConnection!

    """Faceted filter-option counts for one device's software — same scope as deviceSoftware(machineId, search);
    mirrors softwareFilters. Unknown machineId → NOT_FOUND; a device with nothing installed → empty facets."""
    deviceSoftwareFilters(machineId: String!, filter: SoftwareFilterInput, search: String): SoftwareFilters!

    """CVEs present on one device. One row = one CVE (not CVE × software), the same node as `vulnerabilities`.
    `affectedSoftware` is scoped to this host and populated on every row; `devicesCount` is null here
    (the fleet-wide count would cost one Fleet call per row).
    Sortable fields: severity (by cvssScore, unrated last), discoveredAt (default: severity DESC, cveId ASC).
    Unknown machineId → NOT_FOUND; a known device with no CVEs → empty connection."""
    deviceVulnerabilities(
        machineId: String!,
        filter: VulnerabilityFilterInput,
        first: Int,
        after: String,
        last: Int,
        before: String,
        search: String,
        sort: SortInput
    ): VulnerabilityConnection!

    """Faceted severity counts for one device's CVEs — same scope as deviceVulnerabilities(machineId, search);
    mirrors vulnerabilityFilters. Unknown machineId → NOT_FOUND; a device with no CVEs → empty facets."""
    deviceVulnerabilityFilters(machineId: String!, filter: VulnerabilityFilterInput, search: String): VulnerabilityFilters!
}

# ────────── Software (aggregate row) ──────────

type Software {
    id: ID!
    name: String!
    publisher: String

    """Package-manager source — WINGET / CHOCOLATEY / BREW / UNMANAGED."""
    source: SoftwareSource

    """Most-recent version installed anywhere in the fleet — shown as CURRENT VERSION."""
    currentVersion: String

    """Most up-to-date known version — shown as Latest Version on the detail page."""
    latestVersion: String

    """UP_TO_DATE / OUTDATED / UNKNOWN — drives the "OUTDATED" chip in the list."""
    versionStatus: SoftwareVersionStatus

    """Additional older versions in use across the fleet, beyond currentVersion.
    Shows as "+N older versions" line in the list."""
    olderVersionsCount: Int

    """Vulnerability roll-up — highest severity + CVE count for the badge."""
    vulnerabilitySummary: SoftwareVulnerabilitySummary

    """False when the vulnerability scanner could not find a matching CPE entry
    — shown as "no CPE match" instead of a severity badge."""
    cpeMatched: Boolean

    """Kind of software — the Type field on the detail page (e.g. "Application")."""
    type: SoftwareType

    """AUTO-UPDATE column and the detail page's "Turn Off Auto-Update" button (shown while ON).
    Filterable with the same values (SoftwareFilterInput.autoUpdateStatuses). Null = unknown."""
    autoUpdate: SoftwareAutoUpdateStatus

    """Devices that have this title installed manually (installedBy UNMANAGED) and can be adopted — the
    ADOPTION column and the "N devices have … installed manually" banner with Adopt. Null or 0 = "–", no banner;
    always 0 when autoUpdate is NO_PACKAGE (nothing to adopt with).
    Sortable as adoptionCount."""
    adoptionCount: Int
}

type SoftwareVulnerabilitySummary {
    highestSeverity: SoftwareCveSeverity
    cveCount: Int!
}

# ────────── Software on device (per-device row) ──────────

type SoftwareOnDevice {
    device: Machine!
    softwareVersion: String
    status: SoftwareOnDeviceStatus

    """INSTALLED BY column: the package manager that installed it here (WINGET / CHOCOLATEY / BREW), or
    UNMANAGED for "Manually". Null = unknown."""
    installedBy: SoftwareSource

    """Set while an adoption of this device runs or after it failed — the ADOPTING / ADOPTION FAILED chip that
    replaces installedBy. ADOPTING on an offline device shows "Starts when online" (from device.status).
    Null = no adoption."""
    adoption: SoftwareAdoption

    """AUTO-UPDATE column for this device. Filterable with the same values
    (SoftwareOnDeviceFilterInput.autoUpdateStatuses). Null = unknown."""
    autoUpdate: SoftwareAutoUpdateStatus
}

"""An adoption of one device: the manually installed copy is reinstalled with a package manager, so it can be
updated."""
type SoftwareAdoption {
    status: SoftwareAdoptionStatus!
    "The package manager the copy is reinstalled with."
    packageManager: PackageManagerType
    "Why the adoption failed. FAILED only."
    error: String
}

# ────────── Vulnerability (CVE row) ──────────

type SoftwareVulnerability {
    cveId: String!
    severity: SoftwareCveSeverity
    cvssScore: Float
    affectedVersion: String
    discoveredAt: String
}

# ────────── Enums ──────────

enum SoftwareSource {
    WINGET
    CHOCOLATEY
    BREW
    UNMANAGED
}

enum SoftwareVersionStatus {
    UP_TO_DATE
    OUTDATED
    UNKNOWN
}

enum SoftwareCveSeverity {
    CRITICAL
    HIGH
    MEDIUM
    LOW
    NONE
}

"""Kind of software, from the inventory source."""
enum SoftwareType {
    "Desktop applications (Windows programs, macOS apps)."
    APPLICATION
    "Browser extensions and add-ons."
    BROWSER_EXTENSION
    "OS and package-manager packages (deb, rpm, Homebrew, Chocolatey, …)."
    PACKAGE
    OTHER
}

"""Whether software can be and is kept updated automatically — the AUTO-UPDATE column and its filter."""
enum SoftwareAutoUpdateStatus {
    "An auto-update policy keeps it updated (the ON tag)."
    ON
    "A package manager installed it, but no auto-update policy covers it (the OFF tag)."
    OFF
    "No package manager has a package for this app, so it can't be auto-updated or adopted (\"No package found\")."
    NO_PACKAGE
    "Installed by hand: it needs adoption first (\"–\")."
    NEEDS_ADOPTION
}

enum SoftwareAdoptionStatus {
    "Reinstall with a package manager is queued or running; on an offline device it starts when it comes online."
    ADOPTING
    "The reinstall failed; the manually installed copy is left as it was."
    FAILED
}

"""Per-device software state: static (UP_TO_DATE / OUTDATED) or in a lifecycle
transition (SCHEDULED_UPDATE / UNINSTALLING / SCHEDULED_UNINSTALL)."""
enum SoftwareOnDeviceStatus {
    UP_TO_DATE
    OUTDATED
    SCHEDULED_UPDATE
    UNINSTALLING
    SCHEDULED_UNINSTALL
}

# ────────── Connections (Relay-style) ──────────

type SoftwareConnection {
    edges: [SoftwareEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type SoftwareEdge {
    node: Software!
    cursor: String!
}

type SoftwareOnDeviceConnection {
    edges: [SoftwareOnDeviceEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type SoftwareOnDeviceEdge {
    node: SoftwareOnDevice!
    cursor: String!
}

type SoftwareVulnerabilityConnection {
    edges: [SoftwareVulnerabilityEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type SoftwareVulnerabilityEdge {
    node: SoftwareVulnerability!
    cursor: String!
}

# ────────── Facet dropdowns ──────────

type SoftwareFilters {
    sources: [SoftwareFilterOption!]!
    versionStatuses: [SoftwareFilterOption!]!
    severities: [SoftwareFilterOption!]!
    "AUTO-UPDATE dropdown: ON / OFF / NO_PACKAGE / NEEDS_ADOPTION."
    autoUpdateStatuses: [SoftwareFilterOption!]!
}

type SoftwareOnDeviceFilters {
    statuses: [SoftwareFilterOption!]!
    "INSTALLED BY dropdown: WINGET / CHOCOLATEY / BREW / UNMANAGED (Manually)."
    installedBy: [SoftwareFilterOption!]!
    "AUTO-UPDATE dropdown: ON / OFF / NO_PACKAGE / NEEDS_ADOPTION."
    autoUpdateStatuses: [SoftwareFilterOption!]!
    "CUSTOMER dropdown of the Adopt device picker: value = organizationId, label = its name."
    organizations: [SoftwareFilterOption!]!
    "STATUS dropdown of the Adopt device picker: the device statuses."
    deviceStatuses: [SoftwareFilterOption!]!
}

type SoftwareFilterOption {
    value: String!
    label: String!
    count: Int!
}

# ────────── Inputs ──────────

input SoftwareFilterInput {
    sources: [SoftwareSource!]
    versionStatuses: [SoftwareVersionStatus!]
    minSeverity: SoftwareCveSeverity
    deviceTagIds: [ID!]
    autoUpdateStatuses: [SoftwareAutoUpdateStatus!]
}

input SoftwareOnDeviceFilterInput {
    statuses: [SoftwareOnDeviceStatus!]
    deviceTagIds: [ID!]
    "The CUSTOMER filter of the Adopt device picker."
    organizationIds: [ID!]
    "The STATUS filter of the Adopt device picker (the device's own status, e.g. ACTIVE = Managed)."
    deviceStatuses: [DeviceStatus!]
    installedBy: [SoftwareSource!]
    autoUpdateStatuses: [SoftwareAutoUpdateStatus!]
}

input SoftwareVulnerabilityFilterInput {
    severities: [SoftwareCveSeverity!]
}

# ────────── Global vulnerability (CVE row) ──────────

"""Global CVE record. Detail-only fields (description, resolvedInVersion, affectedSoftware)
are null on list rows and populated on the detail page."""
type Vulnerability {
    cveId: String!

    """Severity bucketed from CVSS via the NVD ranges (CRITICAL ≥ 9, HIGH ≥ 7, MEDIUM ≥ 4, LOW > 0).
    Null when Fleet has no CVSS score for the CVE."""
    severity: SoftwareCveSeverity

    cvssScore: Float

    """Exploit Prediction Scoring System probability (0..1) — Fleet Premium only."""
    epssProbability: Float

    """True when the CVE is on CISA's Known Exploited Vulnerabilities list — Fleet Premium only."""
    cisaKnownExploit: Boolean

    """When Fleet first matched this CVE against installed software (Fleet's created_at)."""
    discoveredAt: String

    """External details link Fleet returns (usually NVD)."""
    detailsLink: String

    """Number of tenant devices affected by any (software, version) pair hit by this CVE."""
    devicesCount: Int

    # ── Detail-only ──
    description: String
    resolvedInVersion: String
    affectedSoftware: [AffectedSoftware!]
}

"""One row of the "Affected Software" table on the vulnerability detail page."""
type AffectedSoftware {
    id: ID!
    name: String!
    source: SoftwareSource
    version: String
    devicesCount: Int
    """Distinct customers (organizations) among the affected devices — powers the "N Customers" line."""
    customersCount: Int
    resolvedInVersion: String
}

type VulnerabilityConnection {
    edges: [VulnerabilityEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type VulnerabilityFilters {
    severities: [SoftwareFilterOption!]!
}

type VulnerabilityEdge {
    node: Vulnerability!
    cursor: String!
}

input VulnerabilityFilterInput {
    """Cut-off severity — rows with severity below this are excluded."""
    minSeverity: SoftwareCveSeverity
    """True → only CVEs on CISA's Known Exploited Vulnerabilities list."""
    exploited: Boolean
}

# GraphQL schema for RMM software management (install / update packages).
#
# Built entirely on top of the existing RMM script-execution machinery: each package becomes its
# own execution over the dedicated software NATS pipe, tracked by the same Execution history and
# watchdog. Tenant scoping is implicit (resolved from the authenticated principal).
#
# PackageManagerType and BrewPackageType are declared in package-search.graphqls and reused here.

"""Install vs update — the two software management actions. Also scopes a package's Execution
History (softwareExecutions)."""
enum SoftwareAction {
    INSTALL
    UPDATE
}

extend type Mutation {
    """Install one or more catalog packages on the given devices, immediately. Each package is
    dispatched as its own RMM execution; returns one result (with its executionId) per package."""
    installSoftware(input: SoftwareManagementInput!): [SoftwareDispatchResult!]!

    """Update one or more catalog packages on the given devices, immediately. Each package is
    dispatched as its own RMM execution; returns one result (with its executionId) per package."""
    updateSoftware(input: SoftwareManagementInput!): [SoftwareDispatchResult!]!

    """Adopt a software title on devices that have it installed manually: reinstall it with a package manager,
    so it can be updated. Runs now; an offline device starts when it comes online. The device picker lists
    softwareDevices(softwareId, filter: {installedBy: [UNMANAGED]}). Returns one result per package manager used
    (each its own execution, shown as an ADOPT row in Software Actions)."""
    adoptSoftware(input: AdoptSoftwareInput!): [SoftwareDispatchResult!]!

    """Turn off auto-update for a software title on every device ("Turn Off Auto-Update"). Running updates
    finish; no new version is installed automatically. Turned on again through Update Software (autoUpdate).
    Idempotent: a title that has no auto-update is returned as it is. Unknown softwareId → NOT_FOUND."""
    turnOffSoftwareAutoUpdate(softwareId: ID!): Software!
}

# ────────── Adopt ──────────

input AdoptSoftwareInput {
    "The software title (Software.id) to adopt."
    softwareId: ID!
    """Selected devices (Machine global ids), 1..100. Devices that do not have the title installed manually are
    skipped. Null = every device matching filter + search ("Add All Devices")."""
    machineIds: [ID!]
    """With machineIds null: the devices to adopt, as the picker's softwareDevices(softwareId, filter, search) lists
    them. Always narrowed to installedBy UNMANAGED. Ignored when machineIds is set."""
    filter: SoftwareOnDeviceFilterInput
    search: String
    "Package Manager for Windows. macOS devices always adopt with Brew."
    windowsPackageManager: SoftwareAdoptionWindowsManager! = MATCH_CUSTOMER
}

"""Which package manager adopts the title on Windows devices."""
enum SoftwareAdoptionWindowsManager {
    "The manager each customer already uses for this app; Winget if none."
    MATCH_CUSTOMER
    WINGET
    CHOCOLATEY
}

"""A set of catalog packages to install/update on a set of devices."""
input SoftwareManagementInput {
    "Target device machineIds (subject-safe tokens). 1..100."
    machineIds: [String!]!
    "Packages to act on. 1..50."
    packages: [SoftwarePackageInput!]!
}

"""One package chosen from the catalog, identified exactly as package search returns it."""
input SoftwarePackageInput {
    packageManager: PackageManagerType!
    packageName: String!
    "Brew-only sub-type (CASK/FORMULA). Required for brew (enforced server-side), ignored by managers that do not distinguish."
    brewPackageType: BrewPackageType
    version: String
    """The Software (Fleet title) this package updates, when the update starts from a software page. Links an
    auto-update this package turns on to that Software's autoUpdate and turnOffSoftwareAutoUpdate."""
    softwareId: ID
}

"""The dispatch outcome for one package: its shared executionId across the targeted devices."""
type SoftwareDispatchResult {
    packageManager: PackageManagerType!
    packageName: String!
    executionId: String!
}

# ────────── Update settings (Update Software → "Update Settings" / "Auto-update") ──────────

"""What an update does on a device where the app is running."""
enum PackageUpdateMode {
    "Wait & notify: the user gets Update now or Ask later; once they close the app, it updates."
    WAIT
    "Force install: the user gets a short countdown, then the app closes and updates."
    FORCE
}

"""How an update behaves on a device where the app is running. UPDATE only."""
type PackageUpdateSettings {
    mode: PackageUpdateMode!
    "WAIT only: seconds after the first try before the countdown starts. Null = no deadline, the update waits."
    deadlineSeconds: Long
    "Seconds of countdown before the app is closed: after the deadline (WAIT) or right away (FORCE)."
    countdownSeconds: Int!
}

input PackageUpdateSettingsInput {
    mode: PackageUpdateMode!
    "WAIT only, up to 2592000 (30 days); ignored for FORCE. Null = no deadline (\"Countdown after the deadline\" off)."
    deadlineSeconds: Long
    "Up to 3600 (1 hour)."
    countdownSeconds: Int!
}

"""Keep it auto-updated: after this update, every new version is installed on the same devices. UPDATE only."""
type SoftwareAutoUpdate {
    enabled: Boolean!
    "The settings the auto-updates run with. Null = the update's own (\"Same settings for auto-update\")."
    settings: PackageUpdateSettings
}

input SoftwareAutoUpdateInput {
    enabled: Boolean!
    "Null = the update's own settings (\"Same settings for auto-update\"). Ignored while enabled is false."
    settings: PackageUpdateSettingsInput
}
