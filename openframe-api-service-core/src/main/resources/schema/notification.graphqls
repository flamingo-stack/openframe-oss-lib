extend type Query {
    notifications(filter: NotificationFilterInput, search: String, first: Int, after: String, last: Int, before: String, sort: SortInput): NotificationConnection!
    hasUnreadNotifications: Boolean!
    unreadCountsByCategory: [UnreadCategoryCount!]!
}

extend type Mutation {
    markNotificationAsRead(notificationId: ID!): Boolean!
    markAllNotificationsAsRead: Int!
    deleteNotification(notificationId: ID!): Boolean!
    deleteAllReadNotifications: Int!
    "Cards stay in the list as read; only the counts drop. The returned number spans categories — refetch, do not subtract it."
    markNotificationsReadForEntity(entityType: NotificationEntityType!, entityId: ID!): Int!
}

enum NotificationEntityType {
    TICKET
    DIALOG
    INSIGHT
    DEVICE
}


enum NotificationSeverity {
    INFO
    SUCCESS
    WARNING
    DANGER
}

type Notification implements Node {
    id: ID!
    severity: NotificationSeverity!
    title: String!
    description: String
    createdAt: Instant!
    "The recipient's read state of this notification. DELETED rows are never listed."
    status: NotificationReadStatus!
    category: NotificationCategory!
    "Spec-driven notification type."
    type: String
    "Flat string map of the notification's facts, snapshotted at emission."
    attributes: JSON
}

enum NotificationReadStatus {
    UNREAD
    READ
    "Read automatically because its ticket or dialog was archived; turns into READ on the first interaction."
    ARCHIVED
    DELETED
}

enum NotificationCategory {
    DASHBOARD
    CUSTOMERS
    DEVICES
    SCRIPTS
    MONITORING
    SOFTWARE
    LOGS
    TICKETS
    INSIGHTS
    MINGO
    INTEGRATIONS
    BILLING
    GENERIC
}

type UnreadCategoryCount {
    category: NotificationCategory!
    count: Int!
}

input NotificationFilterInput {
    read: Boolean
    "Only notifications of these categories; omitted or empty does not narrow."
    categories: [NotificationCategory!]
    "Only these notification types, by their persisted name (e.g. TICKET_APPROVAL_REQUEST, MINGO_APPROVAL_REQUEST); omitted or empty does not narrow."
    types: [String!]
    "Only these severities; omitted or empty does not narrow."
    severities: [NotificationSeverity!]
    "Only the caller's notifications about this entity; combines (AND) with the other filters. Omitted does not narrow."
    entity: NotificationEntityFilterInput
}

"""
One entity's notifications. id is the raw stored id: Machine.machineId for DEVICE, the ticket, dialog or
insight id otherwise — the same value markNotificationsReadForEntity takes.
"""
input NotificationEntityFilterInput {
    type: NotificationEntityType!
    id: ID!
}

type NotificationConnection {
    edges: [NotificationEdge!]!
    pageInfo: PageInfo!
    "Number of notifications matching the filter and search, across all pages."
    filteredCount: Int!
}

type NotificationEdge {
    node: Notification!
    cursor: String!
}
