extend type Query {
    """
    Search packages of a package manager (Homebrew, Chocolatey, winget). Homebrew and winget packages come
    from their public repositories; Chocolatey packages come from the OpenFrame feed catalog, with a name,
    a description, a homepage and one current version each.
    Homebrew and winget results are ranked by match quality with popularity/canonical-id
    tiebreaks; Chocolatey results are ranked by match quality, then by name.
    Forward cursor pagination only: pass `pageInfo.endCursor` back as `after`.
    """
    searchPackages(
        packageManager: PackageManagerType!,
        search: String,
        first: Int,
        after: String,
        last: Int,
        before: String
    ): PackageSearchConnection!
    """
    Package details by identifier, including available versions (newest first; Chocolatey has the one
    current version of the OpenFrame feed catalog).
    Errors with NOT_FOUND when the id is unknown to the package manager.
    """
    packageDetails(packageManager: PackageManagerType!, packageId: ID!, packageType: BrewPackageType): PackageDetails!
}

enum PackageManagerType {
    BREW
    CHOCO
    WINGET
}

"""PRESENT — installed. MISSING — installable, the platform bootstraps it. UNSUPPORTED — can never run on this
device (architecture, edition, build or another OS). UNKNOWN — the agent's probe failed."""
enum PackageManagerState {
    PRESENT
    MISSING
    UNSUPPORTED
    UNKNOWN
}

"BREW only — the same name can exist as both a formula and a cask; other managers ignore it."
enum BrewPackageType {
    FORMULA
    CASK
}

type PackageSearchConnection {
    edges: [PackageSearchEdge!]!
    pageInfo: PageInfo!
    "Total matches for the query (same field name as every other connection)."
    filteredCount: Int!
}

type PackageSearchEdge {
    node: PackageSearchItem!
    cursor: String!
}

type PackageSearchItem {
    "Identifier to pass to packageDetails: brew name/token, Chocolatey package id, winget PackageIdentifier."
    id: ID!
    name: String!
    description: String
    "Latest available version."
    version: String
    "WINGET only in search results."
    publisher: String
    homepage: String
    "Not set in search results; winget provides it in packageDetails."
    iconUrl: String
    "Ready-to-run install command, e.g. `brew install --cask slack`."
    installCommand: String!
    "BREW only — pass it back to packageDetails to open exactly this package, not its twin of the other type."
    packageType: BrewPackageType
    "Install count where the source publishes one: brew 30-day installs. Not set for Chocolatey and winget."
    popularity: Int
    packageManager: PackageManagerType!
}

type PackageDetails {
    id: ID!
    packageManager: PackageManagerType!
    name: String!
    description: String
    publisher: String
    homepage: String
    iconUrl: String
    license: String
    installCommand: String!
    packageType: BrewPackageType
    "BREW only."
    popularity: Int
    tags: [String!]!
    "Available versions, newest first. Homebrew and Chocolatey have only the current one."
    versions: [PackageVersion!]!
}

type PackageVersion {
    version: String!
    "Not set: the catalogs do not carry release dates."
    releasedAt: Instant
    prerelease: Boolean
}
