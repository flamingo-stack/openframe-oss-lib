extend type Query {
    deviceFilters(filter: DeviceFilterInput): DeviceFilters!

    devices(
        filter: DeviceFilterInput
        first: Int
        after: String
        last: Int
        before: String
        search: String
        sort: SortInput
    ): DeviceConnection!

    # Get single device by Relay global ID
    deviceById(id: ID!): Machine

    # Get single device by machineId
    device(machineId: String!): Machine
}

type DeviceFilters {
    statuses: [DeviceFilterOption!]!
    deviceTypes: [DeviceFilterOption!]!
    osTypes: [DeviceFilterOption!]!
    organizationIds: [DeviceFilterOption!]!
    tagKeys: [TagFilterOption!]!
    filteredCount: Int!
}

type DeviceFilterOption {
    value: String!
    label: String!
    count: Int!
}

type TagFilterOption {
    key: String!
    value: String!
    count: Int!
}

input DeviceFilterInput {
    statuses: [DeviceStatus!]
    deviceTypes: [DeviceType!]
    osTypes: [String!]
    organizationIds: [String!]
    tagKeys: [String!]
    tagValues: [String!]
}

type Machine implements Node {
    id: ID!
    machineId: String!
    ip: String
    macAddress: String
    osUuid: String
    agentVersion: String
    status: DeviceStatus
    lastSeen: Instant
    organizationId: String
    organization: Organization
    hostname: String
    displayName: String
    nickname: String
    serialNumber: String
    manufacturer: String
    model: String
    type: DeviceType
    osType: OsType!
    osVersion: String
    osBuild: String
    timezone: String
    registeredAt: Instant
    updatedAt: Instant
    tags: [Tag]
    toolConnections: [ToolConnection]
    installedAgents: [InstalledAgent]
}


enum DeviceStatus {
    PENDING,
    ACTIVE
    INACTIVE
    MAINTENANCE
    DECOMMISSIONED,
    ONLINE,
    OFFLINE,
    PENDING_DELETION,
    DELETED,
    ARCHIVED
}

enum DeviceType {
    DESKTOP
    LAPTOP
    SERVER
    MOBILE_DEVICE
    TABLET
    NETWORK_DEVICE
    IOT_DEVICE
    VIRTUAL_MACHINE
    CONTAINER_HOST
    OTHER
}

type DeviceConnection {
    edges: [DeviceEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type DeviceEdge {
    node: Machine!
    cursor: String!
}

type ToolConnection implements Node {
    id: ID!
    machineId: String!
    toolType: ToolType!
    agentToolId: String!
    status: ConnectionStatus!
    metadata: String
    connectedAt: Instant
    lastSyncAt: Instant
    vulnerabilitiesUpdatedAt: Instant
    disconnectedAt: Instant
}

enum ConnectionStatus {
    CONNECTED
    DISCONNECTED
    ERROR
}

type InstalledAgent implements Node {
    id: ID!
    machineId: String!
    agentType: String!
    version: String!
    createdAt: String
    updatedAt: String
}

extend type Mutation {

    updateDeviceNickname(machineId: String!, nickname: String): Machine!

    # Tag a device, creating the tag key on first use. Values are merged into whatever the
    # device already carries for that key, so this only ever adds. Returns the tag with
    # THIS device's values.
    assignDeviceTag(machineId: String!, key: String!, values: [String!]): Tag!

    # Detach a tag from a device. The tag key itself is kept (use deleteTag to drop it
    # everywhere). False when the device did not carry the tag.
    removeDeviceTag(machineId: String!, tagId: ID!): Boolean!
}
