extend type Query {
    deviceFilters(filter: DeviceFilterInput): DeviceFilters!

    devices(
        filter: DeviceFilterInput
        first: Int
        after: String
        last: Int
        before: String
        search: String
        sort: SortInput
    ): DeviceConnection!

    # Get single device by Relay global ID
    deviceById(id: ID!): Machine

    # Get single device by machineId
    device(machineId: String!): Machine
}

type DeviceFilters {
    statuses: [DeviceFilterOption!]!
    connectivity: [DeviceFilterOption!]!
    """Outdated client options: "true" (client below the minimum supported version) and "false" (supported or unknown version), both always listed, counted under the other filters. The outdated client banner reads the "true" count."""
    clientOutdated: [DeviceFilterOption!]!
    deviceTypes: [DeviceFilterOption!]!
    osTypes: [DeviceFilterOption!]!
    organizationIds: [DeviceFilterOption!]!
    tagKeys: [TagFilterOption!]!
    """SOURCES filter options; [] in OSS, and on the schedule and bundle device pickers."""
    directorySources: [DeviceFilterOption!]!
    """USER filter options: PRIMARY, SHARED, NONE. A machine without a directory link counts as NONE."""
    userLinks: [DeviceFilterOption!]!
    filteredCount: Int!
}

type DeviceFilterOption {
    value: String!
    label: String!
    count: Int!
}

type TagFilterOption {
    key: String!
    value: String!
    count: Int!
}

input DeviceFilterInput {
    statuses: [DeviceStatus!]
    connectivity: [DeviceConnectivity!]
    """true: only devices whose client is below the minimum supported version; false: only supported or unknown versions; null: no filter."""
    clientOutdated: Boolean
    deviceTypes: [DeviceType!]
    osTypes: [String!]
    organizationIds: [String!]
    tagKeys: [String!]
    tagValues: [String!]
    """SOURCES filter: machines one of these directories knows. Matches nothing in OSS."""
    directorySources: [DirectorySource!]
    """USER filter. NONE also matches a machine no external directory integration wrote (every machine in OSS)."""
    userLinks: [DirectoryUserLink!]
}

type Machine implements Node @key(fields: "machineId") @shareable {
    id: ID!
    machineId: String!
    ip: String
    macAddress: String
    osUuid: String
    agentVersion: String
    status: DeviceStatus
    """Whether the agent is talking to us right now, independent of the lifecycle status. Null until the first heartbeat."""
    connectivity: DeviceConnectivity
    """The client runs a version below the minimum supported one (server setting, 1.6.0 by default). False when the version is unknown. The devices sort field "clientOutdated" (DESC = outdated first) uses the same value."""
    clientOutdated: Boolean!
    lastSeen: Instant
    organizationId: String
    organization: Organization
    userId: String
    hostname: String
    displayName: String
    nickname: String
    serialNumber: String
    manufacturer: String
    model: String
    type: DeviceType
    osType: OsType!
    osVersion: String
    osBuild: String
    timezone: String
    registeredAt: Instant
    updatedAt: Instant
    """The device's tag assignments, one node per (device, tag): the device's own values and tagged date, with the
    stored tag definition under `tag`. Batched per device list like `tags`."""
    tagAssignments: [MachineTag!]!
    tags: [Tag] @deprecated(reason: "Use tagAssignments: per-device values under the tag's id collide in Relay caches.")
    toolConnections: [ToolConnection]
    installedAgents: [InstalledAgent]
    """Package managers as last reported by the device agent. Null until the first report."""
    packageManagers: MachinePackageManagers
    """False when no enabled package manager can ever work on this device. Software Management then hides it
    from device pickers and skips it at dispatch; inventory and vulnerabilities still show it."""
    softwareManagementSupported: Boolean!
    """Integrated agents this device's OS version is below the minimum of: they are not installed, updated or kept on
    it. Empty when the OS version is unknown or every agent supports it."""
    unsupportedTools: [UnsupportedTool!]!
    enrollment: DeviceEnrollment
    """SOURCES column: the directories that know this machine besides the agent; [] when none, and always in OSS."""
    directorySources: [DirectorySource!]!
    """USER column: who the machine is tied to; NONE when nobody, and always in OSS."""
    directoryUserLink: DirectoryUserLink!
    """Account ids (DirectoryAccount.id) of the tied users, the primary user first. SHARED shows 'N recent users' with N = its length."""
    directoryUserIds: [String!]!
    """Display name of the user for PRIMARY; null otherwise. devices(search) also matches it."""
    directoryUserName: String
    """The current user's unread notifications about this device (entity DEVICE, machineId). Counts the same
    read states as unreadCountsByCategory, so a row and the sidebar badge agree. 0 when none."""
    unreadNotificationCount: Int!
}

"""A tag assigned to one device. `id` is the tag assignment's, unique per (device, tag) and resolvable through
`node(id:)`; `tag` is the stored definition only (its own createdAt, no device values)."""
type MachineTag implements Node {
    id: ID!
    tag: Tag!
    values: [String!]!
    taggedAt: Instant
    taggedBy: String
}

type DeviceEnrollment {
    registeredAt: Instant!
    connectedAt: Instant
    inventoryConnectedAt: Instant
    ready: Boolean!
}

"""Per-manager state reported by the agent. A manager of another OS reads as UNSUPPORTED."""
type MachinePackageManagers {
    brew: PackageManagerState
    winget: PackageManagerState
    choco: PackageManagerState
    """The Chocolatey found on the device and whether OpenFrame may use it. Null unless choco is PRESENT and the
    agent reported it."""
    chocolatey: MachineChocolatey
}

"""Chocolatey as last reported by the device agent."""
type MachineChocolatey {
    """Installed Chocolatey version. Null when it could not be read (reason BROKEN)."""
    version: String
    """Chocolatey edition as the agent names it, e.g. OPEN_SOURCE."""
    edition: String
    """True when OpenFrame installed this Chocolatey; false for one that was already on the device."""
    ours: Boolean!
    status: ChocolateyStatus!
    """Why action is required, e.g. VERSION_1, UPGRADE_BLOCKED, PINNED, LICENSED, BROKEN, UNSIGNED, WEAK_ACL,
    SEVERAL_INSTALLS. Set only with ACTION_REQUIRED; a newer agent may send other values."""
    reason: String
    """What the admin can choose for this device with setChocolateyDecision. Empty unless the status is
    ACTION_REQUIRED."""
    options: [ChocolateyAdminOption!]!
    """The admin's choice for the current reason. Null until one is made; cleared when the reason changes or action
    is no longer required."""
    decision: ChocolateyAdminOption
}

enum ChocolateyStatus {
    """OpenFrame installs and updates packages through this Chocolatey."""
    MANAGED
    """OpenFrame is upgrading this Chocolatey by itself; packages wait until it is MANAGED."""
    UPGRADE_REQUIRED
    """OpenFrame does not touch this Chocolatey until an admin acts; see reason and options."""
    ACTION_REQUIRED
    """A status this backend does not know; treated as not MANAGED."""
    UNKNOWN
}

enum ChocolateyAdminOption {
    """Leave this Chocolatey as it is: OpenFrame keeps managing no Chocolatey packages on the device."""
    DONT_TOUCH
    """The admin fixes the cause on the device. With reason UPGRADE_BLOCKED OpenFrame tries the upgrade again."""
    ADMIN_FIXES
}


enum DeviceStatus {
    PENDING,
    MANAGED,
    ACTIVE
    INACTIVE
    MAINTENANCE
    DECOMMISSIONED,
    ONLINE,
    OFFLINE,
    PENDING_DELETION,
    DELETED,
    ARCHIVED
}

"""Online right now or not; the devices sort field "connectivity" (DESC = online first) uses the same value."""
enum DeviceConnectivity {
    ONLINE
    OFFLINE
}

enum DeviceType {
    DESKTOP
    LAPTOP
    SERVER
    MOBILE_DEVICE
    TABLET
    NETWORK_DEVICE
    IOT_DEVICE
    VIRTUAL_MACHINE
    CONTAINER_HOST
    OTHER
}

"""Who the machine is tied to. PRIMARY: one declared user. SHARED: several users, or recent users only. NONE: nobody."""
enum DirectoryUserLink {
    PRIMARY
    SHARED
    NONE
}

"""A directory that knows the machine besides the agent."""
enum DirectorySource {
    MICROSOFT_365
    GOOGLE_WORKSPACE
}

type DeviceConnection {
    edges: [DeviceEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type DeviceEdge {
    node: Machine!
    cursor: String!
}

type ToolConnection implements Node {
    id: ID!
    machineId: String!
    toolType: ToolType!
    agentToolId: String!
    status: ConnectionStatus!
    metadata: String
    connectedAt: Instant
    lastSyncAt: Instant
    vulnerabilitiesUpdatedAt: Instant
    disconnectedAt: Instant
}

enum ConnectionStatus {
    CONNECTED
    DISCONNECTED
    ERROR
}

type InstalledAgent implements Node {
    id: ID!
    machineId: String!
    agentType: String!
    version: String!
    createdAt: String
    updatedAt: String
}

extend type Mutation {

    updateDeviceNickname(machineId: String!, nickname: String): Machine!

    """Store the admin's choice for a device whose Chocolatey requires action (MachineChocolatey.options).
    Valid only while packageManagers.chocolatey.status is ACTION_REQUIRED, otherwise BAD_REQUEST. NOT_FOUND for an
    unknown device. machineId is the plain Machine.machineId."""
    setChocolateyDecision(machineId: String!, option: ChocolateyAdminOption!): Machine!
}

"""An integrated agent that does not run on the device's OS version."""
type UnsupportedTool {
    toolType: ToolType!
    minOsVersion: String!
    osVersion: String!
}
