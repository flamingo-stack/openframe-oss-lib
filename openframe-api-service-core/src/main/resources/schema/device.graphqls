extend type Query {
    deviceFilters(filter: DeviceFilterInput): DeviceFilters!

    devices(
        filter: DeviceFilterInput
        first: Int
        after: String
        last: Int
        before: String
        search: String
        sort: SortInput
    ): DeviceConnection!

    # Get single device by Relay global ID
    deviceById(id: ID!): Machine

    # Get single device by machineId
    device(machineId: String!): Machine
}

type DeviceFilters {
    statuses: [DeviceFilterOption!]!
    connectivity: [DeviceFilterOption!]!
    deviceTypes: [DeviceFilterOption!]!
    osTypes: [DeviceFilterOption!]!
    organizationIds: [DeviceFilterOption!]!
    tagKeys: [TagFilterOption!]!
    filteredCount: Int!
}

type DeviceFilterOption {
    value: String!
    label: String!
    count: Int!
}

type TagFilterOption {
    key: String!
    value: String!
    count: Int!
}

input DeviceFilterInput {
    statuses: [DeviceStatus!]
    connectivity: [DeviceConnectivity!]
    deviceTypes: [DeviceType!]
    osTypes: [String!]
    organizationIds: [String!]
    tagKeys: [String!]
    tagValues: [String!]
}

type Machine implements Node @key(fields: "machineId") @shareable {
    id: ID!
    machineId: String!
    ip: String
    macAddress: String
    osUuid: String
    agentVersion: String
    status: DeviceStatus
    """Whether the agent is talking to us right now, independent of the lifecycle status. Null until the first heartbeat."""
    connectivity: DeviceConnectivity
    lastSeen: Instant
    organizationId: String
    organization: Organization
    userId: String
    hostname: String
    displayName: String
    nickname: String
    serialNumber: String
    manufacturer: String
    model: String
    type: DeviceType
    osType: OsType!
    osVersion: String
    osBuild: String
    timezone: String
    registeredAt: Instant
    updatedAt: Instant
    tags: [Tag]
    toolConnections: [ToolConnection]
    installedAgents: [InstalledAgent]
    """Package managers as last reported by the device agent. Null until the first report."""
    packageManagers: MachinePackageManagers
    """False when no enabled package manager can ever work on this device. Software Management then hides it
    from device pickers and skips it at dispatch; inventory and vulnerabilities still show it."""
    softwareManagementSupported: Boolean!
    enrollment: DeviceEnrollment
    """The current user's unread notifications about this device (entity DEVICE, machineId). Counts the same
    read states as unreadCountsByCategory, so a row and the sidebar badge agree. 0 when none."""
    unreadNotificationCount: Int!
}

type DeviceEnrollment {
    registeredAt: Instant!
    connectedAt: Instant
    inventoryConnectedAt: Instant
    ready: Boolean!
}

"""Per-manager state reported by the agent. A manager of another OS reads as UNSUPPORTED."""
type MachinePackageManagers {
    brew: PackageManagerState
    winget: PackageManagerState
    choco: PackageManagerState
}


enum DeviceStatus {
    PENDING,
    MANAGED,
    ACTIVE
    INACTIVE
    MAINTENANCE
    DECOMMISSIONED,
    ONLINE,
    OFFLINE,
    PENDING_DELETION,
    DELETED,
    ARCHIVED
}

"""Online right now or not; the devices sort field "connectivity" (DESC = online first) uses the same value."""
enum DeviceConnectivity {
    ONLINE
    OFFLINE
}

enum DeviceType {
    DESKTOP
    LAPTOP
    SERVER
    MOBILE_DEVICE
    TABLET
    NETWORK_DEVICE
    IOT_DEVICE
    VIRTUAL_MACHINE
    CONTAINER_HOST
    OTHER
}

type DeviceConnection {
    edges: [DeviceEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type DeviceEdge {
    node: Machine!
    cursor: String!
}

type ToolConnection implements Node {
    id: ID!
    machineId: String!
    toolType: ToolType!
    agentToolId: String!
    status: ConnectionStatus!
    metadata: String
    connectedAt: Instant
    lastSyncAt: Instant
    vulnerabilitiesUpdatedAt: Instant
    disconnectedAt: Instant
}

enum ConnectionStatus {
    CONNECTED
    DISCONNECTED
    ERROR
}

type InstalledAgent implements Node {
    id: ID!
    machineId: String!
    agentType: String!
    version: String!
    createdAt: String
    updatedAt: String
}

extend type Mutation {

    updateDeviceNickname(machineId: String!, nickname: String): Machine!
}
