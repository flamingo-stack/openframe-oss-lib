extend type Query {
    deviceFilters(filter: DeviceFilterInput): DeviceFilters!

    devices(
        filter: DeviceFilterInput
        first: Int
        after: String
        last: Int
        before: String
        search: String
        sort: SortInput
    ): DeviceConnection!

    # Get single device by Relay global ID
    deviceById(id: ID!): Machine

    # Get single device by machineId
    device(machineId: String!): Machine
}

type DeviceFilters {
    statuses: [DeviceFilterOption!]!
    deviceTypes: [DeviceFilterOption!]!
    osTypes: [DeviceFilterOption!]!
    organizationIds: [DeviceFilterOption!]!
    tagKeys: [TagFilterOption!]!
    filteredCount: Int!
}

type DeviceFilterOption {
    value: String!
    label: String!
    count: Int!
}

type TagFilterOption {
    key: String!
    value: String!
    count: Int!
}

input DeviceFilterInput {
    statuses: [DeviceStatus!]
    deviceTypes: [DeviceType!]
    osTypes: [String!]
    organizationIds: [String!]
    tagKeys: [String!]
    tagValues: [String!]
    """SOURCES filter: machines one of these directories knows. Matches nothing in OSS."""
    directorySources: [DirectorySource!]
    """USER filter. NONE also matches a machine the directory matcher never wrote (every machine in OSS)."""
    userLinks: [DirectoryUserLink!]
}

type Machine implements Node @key(fields: "machineId") @shareable {
    id: ID!
    machineId: String!
    ip: String
    macAddress: String
    osUuid: String
    agentVersion: String
    status: DeviceStatus
    lastSeen: Instant
    organizationId: String
    organization: Organization
    userId: String
    hostname: String
    displayName: String
    nickname: String
    serialNumber: String
    manufacturer: String
    model: String
    type: DeviceType
    osType: OsType!
    osVersion: String
    osBuild: String
    timezone: String
    registeredAt: Instant
    updatedAt: Instant
    tags: [Tag]
    toolConnections: [ToolConnection]
    installedAgents: [InstalledAgent]
    """Package managers as last reported by the device agent. Null until the first report."""
    packageManagers: MachinePackageManagers
    """False when no enabled package manager can ever work on this device. Software Management then hides it
    from device pickers and skips it at dispatch; inventory and vulnerabilities still show it."""
    softwareManagementSupported: Boolean!
    enrollment: DeviceEnrollment
    """SOURCES column: the directories that know this machine besides the agent; [] when none, and always in OSS."""
    directorySources: [DirectorySource!]!
    """USER column: who the machine is tied to; NONE when nobody, and always in OSS."""
    directoryUserLink: DirectoryUserLink!
    """Account ids (DirectoryAccount.id) of the tied users, the primary user first. SHARED shows 'N recent users' with N = its length."""
    directoryUserIds: [String!]!
    """Display name of the user for PRIMARY; null otherwise. devices(search) also matches it."""
    directoryUserName: String
}

type DeviceEnrollment {
    registeredAt: Instant!
    connectedAt: Instant
    inventoryConnectedAt: Instant
    ready: Boolean!
}

"""Per-manager state reported by the agent. A manager of another OS reads as UNSUPPORTED."""
type MachinePackageManagers {
    brew: PackageManagerState
    winget: PackageManagerState
    choco: PackageManagerState
}


enum DeviceStatus {
    PENDING,
    ACTIVE
    INACTIVE
    MAINTENANCE
    DECOMMISSIONED,
    ONLINE,
    OFFLINE,
    PENDING_DELETION,
    DELETED,
    ARCHIVED
}

enum DeviceType {
    DESKTOP
    LAPTOP
    SERVER
    MOBILE_DEVICE
    TABLET
    NETWORK_DEVICE
    IOT_DEVICE
    VIRTUAL_MACHINE
    CONTAINER_HOST
    OTHER
}

"""Who the machine is tied to (D20). PRIMARY: one declared user. SHARED: several users, or recent users only. NONE: nobody."""
enum DirectoryUserLink {
    PRIMARY
    SHARED
    NONE
}

"""A directory that knows the machine besides the agent (D19)."""
enum DirectorySource {
    MICROSOFT_365
    GOOGLE_WORKSPACE
}

type DeviceConnection {
    edges: [DeviceEdge!]!
    pageInfo: PageInfo!
    filteredCount: Int!
}

type DeviceEdge {
    node: Machine!
    cursor: String!
}

type ToolConnection implements Node {
    id: ID!
    machineId: String!
    toolType: ToolType!
    agentToolId: String!
    status: ConnectionStatus!
    metadata: String
    connectedAt: Instant
    lastSyncAt: Instant
    vulnerabilitiesUpdatedAt: Instant
    disconnectedAt: Instant
}

enum ConnectionStatus {
    CONNECTED
    DISCONNECTED
    ERROR
}

type InstalledAgent implements Node {
    id: ID!
    machineId: String!
    agentType: String!
    version: String!
    createdAt: String
    updatedAt: String
}

extend type Mutation {

    updateDeviceNickname(machineId: String!, nickname: String): Machine!
}
