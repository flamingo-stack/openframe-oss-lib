{
  "tableName": "${pinot.tables.check-results.name}",
  "tableType": "REALTIME",
  "segmentsConfig": {
    "timeColumnName": "runTimestamp",
    "timeType": "MILLISECONDS",
    "replication": "${pinot.tables.check-results.replication}",
    "segmentAssignmentStrategy": "BalanceNumSegmentAssignmentStrategy",
    "retentionTimeUnit": "DAYS",
    "retentionTimeValue": "${pinot.tables.check-results.retention-days:90}"
  },
  "tableIndexConfig": {
    "loadMode": "MMAP",
    "nullHandlingEnabled": true,
    "optimizeDictionary": true,
    "invertedIndexColumns": [
      "tenantId",
      "organizationId",
      "deviceId",
      "check",
      "metric",
      "status"
    ],
    "rangeIndexColumns": [
      "runTimestamp"
    ],
    "sortedColumn": ["runTimestamp"],
    "streamConfigs": {
      "streamType": "kafka",
      "stream.kafka.topic.name": "${openframe.oss-tenant.kafka.topics.inbound.check-results.name}",
      "stream.kafka.broker.list": "${spring.oss-tenant.kafka.bootstrap-servers}",
      "stream.kafka.consumer.type": "lowlevel",
      "stream.kafka.decoder.class.name": "org.apache.pinot.plugin.stream.kafka.KafkaJSONMessageDecoder",
      "stream.kafka.consumer.prop.auto.offset.reset": "smallest",
      "realtime.segment.flush.threshold.time": "6h",
      "realtime.segment.flush.threshold.rows": "500000"
    }
  },
  "tenants": {
    "broker": "DefaultTenant",
    "server": "DefaultTenant"
  }
}
