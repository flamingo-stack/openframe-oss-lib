# ─── Proxy (SERVER-ONLY — never shipped to the browser) ──────────────────────
# Where the proxy forwards /content/api/* → ${HUB_ORIGIN}/api/* .
HUB_ORIGIN=http://localhost:3000

# Credentials are NOT env vars: open the app's /debug page and paste a
# platform API key (hub /admin/api-keys) + act-as email — stored in the
# browser's localStorage, attached by every surface client-side.

# ─── Mingo (SERVER-ONLY: proxy/agent.mjs, the AI service's chat loop) ─────────
# The model key Mingo's loop calls Anthropic with.
ANTHROPIC_API_KEY=
# The model; the AI service's production default when unset.
MINGO_MODEL=claude-opus-5-5
# The hub key Mingo calls the hub's MCP server with, as the AI service does (same
# name). Unset: the browser's /debug key is used.
HUB_MCP_API_KEY=

# ─── Client (VITE_-prefixed — these ARE bundled into the browser) ────────────
# Public hub origin for new-tab "open the full content" links the chat/surfaces render.
VITE_HUB_ORIGIN=http://localhost:3000

# NOTE: there is deliberately NO chat-source / platform setting. The client is
# platform-agnostic — the chat wire resolves source server-side (the hub's
# currentPlatform()), client-side link decisions fall back to an origin comparison, and
# the chat-history namespace falls back to a lib default. Point HUB_ORIGIN at any
# platform's hub and it just works.
